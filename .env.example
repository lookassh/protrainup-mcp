# Kopiuj do .env i uzupelnij - plik jest wczytywany automatycznie (z katalogu
# biezacego lub z korzenia projektu) i jest w .gitignore.
# Zmienne srodowiskowe ustawione w powloce maja pierwszenstwo przed tym plikiem.
PROTRAINUP_LOGIN=twoj-login-do-protrainup
PROTRAINUP_PASSWORD=twoje-haslo
# Opcjonalnie (domyslnie https://api.protrainup.com):
# PROTRAINUP_BASE_URL=https://api.protrainup.com
# PROTRAINUP_TIMEOUT=30
