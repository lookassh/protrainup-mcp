# Copy to .env and fill in - the file is auto-loaded (from the current
# directory or the project root) and is gitignored.
# Real environment variables take precedence over this file.
PROTRAINUP_LOGIN=your-protrainup-login
PROTRAINUP_PASSWORD=your-password
# Optional (default https://api.protrainup.com):
# PROTRAINUP_BASE_URL=https://api.protrainup.com
# PROTRAINUP_TIMEOUT=30
# MCP server transport (stdio by default; http for a Docker sidecar):
# PROTRAINUP_MCP_TRANSPORT=http
# PROTRAINUP_MCP_HOST=0.0.0.0
# PROTRAINUP_MCP_PORT=8000
